{
  "name": "ci-kit",
  "version": "1.3.0",
  "description": "Change-impact planning, a fail-closed result gate and workflow rules for GitHub Actions. Node built-ins only.",
  "keywords": [
    "github-actions",
    "ci",
    "continuous-integration",
    "monorepo",
    "change-detection",
    "required-checks",
    "workflow-linter"
  ],
  "homepage": "https://github.com/alipajand/ci-kit#readme",
  "bugs": {
    "url": "https://github.com/alipajand/ci-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alipajand/ci-kit.git"
  },
  "author": "Ali Pajand",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "ci-kit": "bin/ci-kit.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "plan/",
    "result/",
    "merge-conflict/",
    "lint/",
    "templates/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\" \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 \"test/**/*.test.mjs\" \"test/**/*.test.js\"",
    "format": "prettier --write \"src/**/*.mjs\" \"bin/**/*.mjs\" \"test/**/*.mjs\" \"test/**/*.js\" \"*/index.mjs\"",
    "format:check": "prettier --check \"src/**/*.mjs\" \"bin/**/*.mjs\" \"test/**/*.mjs\" \"test/**/*.js\" \"*/index.mjs\"",
    "lint:workflows": "node bin/ci-kit.mjs lint"
  },
  "devDependencies": {
    "fast-check": "4.10.3",
    "prettier": "3.10.1"
  }
}
